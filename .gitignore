# Dependencies
node_modules/

# Environment
.env
.env.*
*.env
# ...but the documented env CONTRACT is safe to share and must be committed,
# otherwise the next dev repeats the "file exists but nothing reads it" bug.
# The example contains placeholders only — never real values.
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# PM2
.pm2/
dump.rdb

# Data (don't commit session data)
data/*.db
data/*.json

# Build outputs
dist/
build/

# Secrets
*.pem
*.key
credentials.json
service-account-*.json
config/token.json

# Rider PII / local DB snapshots — never publish (repo is PUBLIC)
data/
*.db.bak*

# Local operational scripts that carry production credentials / one-off data.
scripts/restore-sessions-to-prod.mjs

# local generated artifacts (not part of the repo)
demo-report.pdf
