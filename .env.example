# MotoTrackIQ Backend v2 — Environment Contract
#
# Copy to `.env` and fill in. The service loads `.env` automatically
# (lib/config.js). Real environment variables always WIN over this file, so
# Railway/PM2/systemd settings are never overridden by a stray local file.
#
# 🚨 THE SERVICE NOW FAILS CLOSED. If `JWT_SECRET` is missing or blank the
# process logs a FATAL message and exits with code 1. It will NOT start with
# a guessable key. (Before Oct 22 2026 the JWT secret had a hardcoded
# fallback that was committed to a PUBLIC GitHub repo — so it was effectively
# a well-known constant and anyone could forge rider tokens.)
#
# Required vs optional below matches lib/config.js exactly.

# ─────────────────────────────────────────────────────────────
# REQUIRED — the service refuses to start without these
# ─────────────────────────────────────────────────────────────

# JWT signing secret for rider auth tokens.
#   Missing/blank  → process exits 1 with "[config] FATAL".
#   Weak/guessed   → tokens can be forged; anyone can act as any rider.
# Generate with: openssl rand -hex 32   (64 hex chars)
# NOTE: tokens carry a 30-day expiry, and the same secret signs report links.
# Rotate it by changing this var and redeploying — no other change needed.
JWT_SECRET=

# ─────────────────────────────────────────────────────────────
# OPTIONAL — have sane defaults; set them to enable a feature
# ─────────────────────────────────────────────────────────────

# Admin key for /api/admin/* endpoints, sent as the X-Admin-Key header.
#   Unset → the admin gate fails closed (503 "Admin access not configured").
#   Weak  → anyone with the key can grant credits, create promo codes, etc.
# Generate with: openssl rand -hex 24
ADMIN_KEY=

# Secret used to sign rider report links. Falls back to JWT_SECRET when unset.
# Set it separately if you want to rotate report links independently of login.
REPORT_LINK_SECRET=

# Port the HTTP server listens on. Default 3009.
PORT=3013

# Node environment. Default "development".
NODE_ENV=production

# ── LemonSqueezy (payment + webhook verification) ────────────
# Webhook signature secret. ⚠️ If empty, webhook signature verification
#    RETURNS FALSE (i.e. every webhook is rejected) — set it or the
#    integration silently does nothing.
LS_WEBHOOK_SECRET=
# API key for the LemonSqueezy API.
LEMONSQUEEZY_API_KEY=
# Product/variant IDs used by the promo + checkout mapping.
LS_STORE_ID=
LS_VARIANT_EVENT=
LS_VARIANT_SEASON=
LS_VARIANT_SINGLE=
# Set to true ONLY on a server pointed at the Lemon Squeezy TEST store. When unset,
# test-mode orders are ignored so a test purchase can never grant on a live account.
LS_TEST_MODE=

# ── Google (Gmail send + Sheets sync) ────────────────────────
# OAuth client + refresh token for OUTGOING MAIL only. The refresh token is
# short-lived and is the single most common thing to silently expire — when
# report emails stop sending, check this first (look for "invalid_grant").
# Do NOT reuse these for rider sign-in. Sign-in uses GOOGLE_OAUTH_* below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Rider sign-in (Google / Microsoft OAuth) ─────────────────
# Direct authorization-code + PKCE. Missing client id/secret disables that
# provider (GET /api/auth/oauth/<provider>/start returns 503). The process
# still boots. Facebook code is present but stays off unless the flag is true.
#
# API_PUBLIC_URL is the origin used to build the provider redirect URI.
# Register these EXACTLY (no trailing slash) in the provider console:
#   ${API_PUBLIC_URL}/api/auth/oauth/google/callback
#   ${API_PUBLIC_URL}/api/auth/oauth/microsoft/callback
# Production example, when API_PUBLIC_URL is the Railway service origin:
#   https://mototrack-iq-backend-production.up.railway.app/api/auth/oauth/google/callback
#   https://mototrack-iq-backend-production.up.railway.app/api/auth/oauth/microsoft/callback
# Unset API_PUBLIC_URL falls back to the request host. Behind Railway, set it
# so the redirect URI does not depend on proxy headers.
API_PUBLIC_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Phase 2 only. Leave false until Meta approves the email permission.
FACEBOOK_OAUTH_ENABLED=false
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# ── Auth abuse controls ──────────────────────────────────────
# Per-IP fixed window on email login, register, forgot-password, and
# resend-verification. Login was not rate-limited before; shipping this
# changes production login behaviour (429 after AUTH_RATE_LIMIT_MAX).
# Defaults: 8 attempts / 900000 ms (15 minutes).
# The limiter keys on X-Real-IP (Railway's edge overwrites it), then req.ip.
AUTH_RATE_LIMIT_MAX=8
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Separate cap for GET /api/auth/oauth/<provider>/start and /callback.
# Default 30 per the same window. These do not write the SQLite file;
# state and the exchange code are kept in memory and dropped on restart.
OAUTH_RATE_LIMIT_MAX=30
# Cloudflare Turnstile on email register, forgot-password, resend-verification,
# and login. Default off: those routes keep working with no widget token.
# Social sign-in never checks Turnstile. The site key is public and is
# returned by GET /api/auth/oauth/providers. The secret is never returned.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email (Gmail send-as / SMTP) ─────────────────────────────
# The address report and notification emails are sent FROM.
# Also printed as the contact email in commercial-mail footers (CASL).
FROM_EMAIL=
# Display name for outgoing mail. Default "MotoTrackIQ".
FROM_NAME=MotoTrackIQ
# The authenticated Gmail account (must match the OAuth grant).
GMAIL_USER=
# Where beta-signup notifications are delivered.
NOTIFY_EMAIL=
# Optional SMTP fallback.
SMTP_USER=
SMTP_PASS=

# Physical mailing address required on commercial email (CASL sender identification).
# Optional. When unset, marketing mail shows "[Mailing address coming soon]" and
# the process logs a startup warning. Transactional mail does not use this.
# Example: 123 Example Street, Brampton, ON L6Y 0C9, Canada
BUSINESS_MAILING_ADDRESS=

# HMAC secret for one-click unsubscribe links. Optional.
# When unset, links are signed with REPORT_LINK_SECRET, or JWT_SECRET if that
# is also unset. Set this if you want unsubscribe links to survive a JWT rotation.
# This does not change JWT_SECRET.
UNSUBSCRIBE_SECRET=

# ── Branding / URLs ─────────────────────────────────────────
# Absolute URL of the frontend, used in CORS and report links.
FRONTEND_URL=https://mototrackiq.com
# URL of the logo embedded in generated PDF reports.
LOGO_URL=

# ── Storage ─────────────────────────────────────────────────
# Path to the SQLite database file. Default: ./data/mototrackiq.db
# ⚠️ This file contains rider PII (names, emails, password hashes). It is
#    git-ignored and must never be committed or published.
DB_PATH=
