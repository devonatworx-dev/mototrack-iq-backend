# MotoTrackIQ Backend v2 — Environment Contract
#
# Copy to `.env` and fill in. The service loads `.env` automatically
# (lib/config.js). Real environment variables always WIN over this file, so
# Railway/PM2/systemd settings are never overridden by a stray local file.
#
# 🚨 THE SERVICE NOW FAILS CLOSED. If `JWT_SECRET` is missing or blank the
# process logs a FATAL message and exits with code 1. It will NOT start with
# a guessable key. (Before Oct 22 2026 the JWT secret had a hardcoded
# fallback that was committed to a PUBLIC GitHub repo — so it was effectively
# a well-known constant and anyone could forge rider tokens.)
#
# Required vs optional below matches lib/config.js exactly.

# ─────────────────────────────────────────────────────────────
# REQUIRED — the service refuses to start without these
# ─────────────────────────────────────────────────────────────

# JWT signing secret for rider auth tokens.
#   Missing/blank  → process exits 1 with "[config] FATAL".
#   Weak/guessed   → tokens can be forged; anyone can act as any rider.
# Generate with: openssl rand -hex 32   (64 hex chars)
# NOTE: tokens carry a 30-day expiry, and the same secret signs report links.
# Rotate it by changing this var and redeploying — no other change needed.
JWT_SECRET=

# ─────────────────────────────────────────────────────────────
# OPTIONAL — have sane defaults; set them to enable a feature
# ─────────────────────────────────────────────────────────────

# Admin key for /api/admin/* endpoints, sent as the X-Admin-Key header.
#   Unset → the admin gate fails closed (503 "Admin access not configured").
#   Weak  → anyone with the key can grant credits, create promo codes, etc.
# Generate with: openssl rand -hex 24
ADMIN_KEY=

# Secret used to sign rider report links. Falls back to JWT_SECRET when unset.
# Set it separately if you want to rotate report links independently of login.
REPORT_LINK_SECRET=

# Port the HTTP server listens on. Default 3009.
PORT=3013

# Node environment. Default "development".
NODE_ENV=production

# ── LemonSqueezy (payment + webhook verification) ────────────
# Webhook signature secret. ⚠️ If empty, webhook signature verification
#    RETURNS FALSE (i.e. every webhook is rejected) — set it or the
#    integration silently does nothing.
LS_WEBHOOK_SECRET=
# API key for the LemonSqueezy API.
LEMONSQUEEZY_API_KEY=
# Product/variant IDs used by the promo + checkout mapping.
LS_STORE_ID=
LS_VARIANT_EVENT=
LS_VARIANT_SEASON=
LS_VARIANT_SINGLE=

# ── Google (Gmail send + Sheets sync) ────────────────────────
# OAuth client + refresh token. The refresh token is short-lived and is the
# single most common thing to silently expire — when report emails stop
# sending, check this first (look for "invalid_grant" in the logs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Email (Gmail send-as / SMTP) ─────────────────────────────
# The address report and notification emails are sent FROM.
FROM_EMAIL=
# Display name for outgoing mail. Default "MotoTrackIQ".
FROM_NAME=MotoTrackIQ
# The authenticated Gmail account (must match the OAuth grant).
GMAIL_USER=
# Where beta-signup notifications are delivered.
NOTIFY_EMAIL=
# Optional SMTP fallback.
SMTP_USER=
SMTP_PASS=

# ── Branding / URLs ─────────────────────────────────────────
# Absolute URL of the frontend, used in CORS and report links.
FRONTEND_URL=https://mototrackiq.com
# URL of the logo embedded in generated PDF reports.
LOGO_URL=

# ── Storage ─────────────────────────────────────────────────
# Path to the SQLite database file. Default: ./data/mototrackiq.db
# ⚠️ This file contains rider PII (names, emails, password hashes). It is
#    git-ignored and must never be committed or published.
DB_PATH=
